# Database Configuration (Standard MySQL params)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=attendance_management
DB_SSL_VERIFY=false

# Optional Direct Database URL override (e.g. for cloud database connection strings)
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:password@cloud-db-host:3306/attendance_management

# Application Settings
APP_ENV=development
APP_PORT=8000

# Authentication & Security Settings
# Set a unique secret (for example: python -c "import secrets; print(secrets.token_urlsafe(32))").
# If left empty, development generates an ephemeral key; production refuses to start.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list of deployed frontend URLs, or * for all)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Initial Admin Account Settings (Development)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@attendance.com
INIT_ADMIN_PASSWORD=

# Optional demo data account passwords; required only when running the demo seeder.
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Academic analysis thresholds
REQUIRED_ATTENDANCE_PERCENTAGE=75
ATTENDANCE_QR_TOKEN_TTL_SECONDS=45
ATTENDANCE_QR_REFRESH_INTERVAL_SECONDS=30
ATTENDANCE_GAP_MEDIUM=5
ATTENDANCE_GAP_HIGH=15
CURRICULUM_GAP_MEDIUM=10
CURRICULUM_GAP_HIGH=25
PENDING_ASSIGNMENTS_MEDIUM=1
PENDING_ASSIGNMENTS_HIGH=3
PERFORMANCE_TARGET_PERCENTAGE=50
PERFORMANCE_HIGH_RISK_PERCENTAGE=35

# Optional RAG services. Configure a trusted OpenAI-compatible embeddings endpoint
# and Qdrant instance before enabling PDF ingestion or retrieval.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=academic_documents
PDF_MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=200
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=32
RAG_MAX_CHUNKS_PER_DOCUMENT=2000
RAG_MIN_SIMILARITY_SCORE=0.25
# OpenAI-compatible chat-completions endpoint and model; keep secrets server-side.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=800
