# Copy this file to .env before using Docker Compose.
# Replace both values with unique, high-entropy secrets.
DB_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Local demonstration defaults. Set explicit public origins for production.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost,http://localhost:5173
DB_NAME=attendance_management
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Optional admin initialization. Leave blank unless explicitly creating an admin.
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@attendance.com
INIT_ADMIN_PASSWORD=

# Optional RAG providers. Credentials remain on the backend.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=academic_documents
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
